{
  "schema_version": 1,
  "quilt_loader": {
    "group": "${mod_id}",
    "id": "${mod_id}",
    "version": "${mod_version}",
    "metadata": {
      "name": "${mod_name}",
      "authors": [
        "${mod_authors}"
      ],
      "description": "Makes your UI flashy :D"
    },
    "intermediate_mappings": "net.fabricmc:intermediary",
    "entrypoints": {
      "init": [
        "it.hurts.octostudios.quilt.ImmersiveUIQuilt"
      ]
    },
    "depends": [
      {
        "id": "quilt_loader",
        "version": "*"
      },
      {
        "id": "quilt_base",
        "version": "*"
      },
      {
        "id": "minecraft",
        "version": "*"
      }
    ]
  },
  "mixin": [
    "immersiveui.mixins.json",
    "immersiveui-common.mixins.json"
  ]
}

{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "icon": "icon.png",
  "license": "${mod_license}",
  "environment": "client",
  "entrypoints": {
    "main": [
      "${mod_group}.fabric.ImmersiveUIFabric"
    ],
    "client": [
      "${mod_group}.fabric.client.ImmersiveUIFabricClient"
    ]
  },
  "mixins": [
    "${mod_id}-common.mixins.json",
    "${mod_id}.mixins.json"
  ],
  "depends": {
    "minecraft": ">=1.21.9",
    "java": ">=21",
    "shatterlib": ">=0.6.0.5",
    "fabric-api": "*"
  }
}
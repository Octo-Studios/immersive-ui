{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "${mod_author}"
  ],
  "icon": "icon.png",
  "license": "${license}",
  "environment": "client",
  "entrypoints": {
    "main": [
      "it.hurts.shatterbyte.immersiveui.fabric.ImmersiveUIFabric"
    ],
    "client": [
      "it.hurts.shatterbyte.immersiveui.fabric.client.ImmersiveUIFabricClient"
    ]
  },
  "mixins": [
    "${mod_id}-common.mixins.json",
    "${mod_id}.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=${java_version}",
    "shatterlib": "*",
    "fabric-api": "*"
  }
}
